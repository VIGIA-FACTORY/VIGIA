# Copy to .env on the server and fill in. Never commit .env (05.01 §3.3).
# Generate each secret with: openssl rand -hex 24

# Domain of this environment. Use the one from the instructor, or <elastic-ip-with-dashes>.sslip.io meanwhile,
# for example 3-90-12-45.sslip.io. The hosts are auth., api., admin. and n8n. under it.
VIGIA_DOMAIN=
ACME_EMAIL=

# Image digests from the "QA images" workflow (sha256:...). Never "latest".
S09_DIGEST=
S01_DIGEST=

POSTGRES_PASSWORD=
IDENTITY_DB_PASSWORD=
COMMUNITY_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
N8N_DB_PASSWORD=
RABBITMQ_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
VIGIA_S09_CLIENT_SECRET=
VIGIA_S01_CLIENT_SECRET=
VIGIA_N8N_CLIENT_SECRET=
N8N_ENCRYPTION_KEY=
