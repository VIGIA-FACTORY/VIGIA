{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Dependency updates as in 05.01 §3.3: grouped by ecosystem, 7 days before a new version is proposed, no automatic merge: every pull request goes to dev and is merged by hand after its checks pass (D-79). Minor and major updates change a version line of 03.04.01 §11, so they are opened only when approved in the Dependency Dashboard.",
  "extends": ["config:recommended", ":semanticCommits", ":semanticCommitScope(deps)"],
  "baseBranchPatterns": ["dev"],
  "minimumReleaseAge": "7 days",
  "labels": ["enhancement"],
  "lockFileMaintenance": { "enabled": false },
  "packageRules": [
    { "matchPackageNames": ["*"], "semanticCommitType": "chore" },
    { "matchManagers": ["gradle", "gradle-wrapper"], "groupName": "Gradle dependencies" },
    { "matchManagers": ["npm"], "groupName": "npm dependencies" },
    { "matchManagers": ["dockerfile", "docker-compose"], "groupName": "Docker images" },
    { "matchManagers": ["github-actions"], "groupName": "GitHub Actions", "pinDigests": true },
    { "matchUpdateTypes": ["minor", "major"], "dependencyDashboardApproval": true },
    { "matchFileNames": ["gradle.properties"], "enabled": false }
  ]
}
